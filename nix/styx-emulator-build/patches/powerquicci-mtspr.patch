+    } else if is_mfspr(insn_bytes) || is_mftb(insn_bytes) {
+        // Read-back of the decrementer/timebase shadow. The MPC8xx DEC/TB SPRs
+        // are not visible to the Unicorn backend, so a guest `mfspr DEC` /
+        // `mftb` would otherwise read stale backend state. Return the SIU
+        // shadow (advanced by the SIU tick) and skip the native instruction.
+        //
+        // `is_mfspr` also matches `mflr`/`mfctr`/`mfxer`, which appear in most
+        // function prologues, so the SPR operand is filtered first: the
+        // peripheral lookup is a linear scan plus a downcast and must not run on
+        // every prologue. Any other SPR is left to execute natively.
+        let spr = MtsprInstruction::parse_spr(insn_bytes);
+        if matches!(spr, Some(SprEnum::DEC | SprEnum::TBLr | SprEnum::TBUr)) {
+            let siu = proc
+                .event_controller
+                .peripherals
+                .get_expect::<SystemInterfaceUnit>()?;
+            let value = match spr {
+                Some(SprEnum::DEC) => siu.mtspr_mgr.dec,
+                Some(SprEnum::TBLr) => siu.mtspr_mgr.tblw,
+                _ => siu.mtspr_mgr.tbuw,
+            };
+            // The register operand is a 5 bit field, so this cannot fail.
+            let register = MtsprInstruction::parse_register(insn_bytes).unwrap();
+            trace!("read shadow {:?} = {:#x} -> {:?}", spr, value, register);
+            proc.cpu.write_register(register, value)?;
+            skip_cpu_insn(proc.cpu);
+        }
