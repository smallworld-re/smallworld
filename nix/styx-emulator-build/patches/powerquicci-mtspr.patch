+    dec_reload: u32,
+    /// Whether the guest has programmed the decrementer at least once. Until it
+    /// does, the decrementer neither counts nor latches (avoids a spurious
+    /// underflow storm from the reset value of 0).
+    dec_active: bool,
 }
 
 impl MtsprStateManager {
@@ -28,12 +35,61 @@
             tblw: 0,
             tbuw: 0,
             dec: 0,
+            dec_reload: 0,
+            dec_active: false,
+        }
+    }
+
+    /// Advance the 64-bit timebase by `step`, and (once the guest has programmed
+    /// it) decrement the decrementer by `step`. Returns `true` if the
+    /// decrementer underflowed, meaning the caller should latch a Decrementer
+    /// exception. Called from the SIU peripheral tick with the elapsed
+    /// instruction count for the stride.
+    pub(crate) fn tick(&mut self, step: u32) -> bool {
+        // The timebase always runs.
+        let tb = (((self.tbuw as u64) << 32) | self.tblw as u64).wrapping_add(step as u64);
+        self.tblw = tb as u32;
+        self.tbuw = (tb >> 32) as u32;
+
+        if !self.dec_active {
+            return false;
+        }
+
+        match self.dec.checked_sub(step) {
+            Some(remaining) => {
+                self.dec = remaining;
+                false
+            }
+            None => {
+                // Underflow. Carry the overshoot into the next period so a
+                // decrementer programmed shorter than one executor stride does
+                // not silently lose ticks, and never re-arm at zero: a guest
+                // that writes `mtspr DEC, 0` would otherwise underflow on every
+                // stride and latch a Decrementer forever.
+                if self.dec_reload == 0 {
+                    self.dec = 0;
+                    self.dec_active = false;
+                } else {
+                    let overshoot = step - self.dec;
+                    self.dec = self.dec_reload - (overshoot % self.dec_reload);
+                }
+                true
+            }
         }
     }
 }
 
 const MTSPR_INSN_MASK: u32 = 0xfc_00_03_ff;
 const MTSPR_INSN_BITS: u32 = 0x7c_00_03_a6;
+/// Like `MTSPR_INSN_MASK`, but covering the whole extended opcode. The extended
+/// opcode plus its Rc bit span 11 bits (`0x7ff`); `MTSPR_INSN_MASK` stops at
+/// `0x3ff`, leaving the extended opcode's top bit free so that XO and XO+512
+/// alias onto each other.
+const MFSPR_INSN_MASK: u32 = 0xfc_00_07_ff;
+/// `mfspr`: primary opcode 31, extended opcode 339.
+const MFSPR_INSN_BITS: u32 = 0x7c_00_02_a6;
+/// `mftb`: primary opcode 31, extended opcode 371.
+const MFTB_INSN_BITS: u32 = 0x7c_00_02_e6;
 const MTSPR_REG_OPERAND_MASK: u32 = 0x03e0_0000;
 const MTSPR_REG_OPERAND_SHIFT: u8 = 21;
 const MTSPR_SPR_OPERAND_MASK: u32 = 0x001f_f800;
