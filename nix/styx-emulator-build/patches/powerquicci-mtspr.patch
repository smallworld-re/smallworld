+    if insn_bytes == RFI_OPCODE {
+        // Under Unicorn `rfi` would execute natively against QEMU's own
+        // SRR0/SRR1, which are not backend-visible and which the controller
+        // never populates, so restore PC/MSR from its shadow instead. MSR is
+        // written before PC so that a failure leaves PC on the `rfi` rather
+        // than resuming with a half-restored MSR.
+        let return_state = proc
+            .event_controller
+            .get_impl::<Mpc866mController>()?
+            .take_return_state();
+        if let Some((srr0, srr1)) = return_state {
+            proc.cpu.write_register(Ppc32Register::Msr, srr1)?;
+            proc.cpu.set_pc(srr0 as u64)?;
+        }
+        return Ok(());
+    }
 
