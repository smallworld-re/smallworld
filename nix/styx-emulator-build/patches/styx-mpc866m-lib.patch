+    fn insert_exception(
+        &mut self,
+        cpu: &mut dyn CpuBackend,
+        irqn: Mpc866mIRQn,
+    ) -> Result<InterruptExecuted, UnknownError> {
+        let msr = cpu.read_register::<u32>(Ppc32Register::Msr)?;
+        let pc = cpu.pc()? as u32;
