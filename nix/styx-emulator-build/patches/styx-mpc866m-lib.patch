+        // SRR0 holds either the next instruction (asynchronous / system call) or
+        // the faulting instruction (synchronous exceptions).
+        let srr0 = if irqn.saved_pc_is_next() {
+            pc
+        } else {
+            pc.wrapping_sub(4)
