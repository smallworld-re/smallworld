Fix Ghidra's Intel 8051 language for emulation.

Ghidra's 8051 specification targets decompilation and gets these wrong when
emulated; nix/ghidra.nix recompiles 8051.sla with this patch applied:

- ADDC and SUBB fold the carry into the operand in one byte, so an operand of
  0xFF with the carry set wraps to 0 and the carry or borrow out is lost.
- ADD, ADDC and SUBB never set AC or OV, so DA A misadjusts and signed
  overflow goes undetected.
- Arithmetic and logic instructions write invented N and Z flags into PSW bits
  5 and 1, which are the user flags F0 and F1.
- Bit instructions use a separate byte per bit (BIT_OPS "BIT_ADDRS") instead of
  the bits of internal RAM 0x20-0x2F and of the SFRs.
- SP has no direct-address alias, so `mov sp,#n` writes SFR 0x81 and leaves SP
  alone.
- MOVX @Ri ignores P2, which supplies the high address byte, so code that
  pages external RAM, as SDCC's startup code does, stays in its first 256
  bytes.  The patch reads the page from the SFR a new register, XPAGE_SFR,
  names, since Silicon Labs' CIP-51 devices page through an EMI0CN instead.

--- a/Ghidra/Processors/8051/data/languages/8051_main.sinc
+++ b/Ghidra/Processors/8051/data/languages/8051_main.sinc
@@ -1,8 +1,11 @@
 # sleigh specification file for Intel 8051
 
 #@define BIT_OPS "PCODEOPS"
-#@define BIT_OPS "SHIFTS" 
-@define BIT_OPS "BIT_ADDRS"
+# SmallWorld: SHIFTS, so bit instructions read and write the bits of internal
+# RAM 0x20-0x2F and of the SFRs, as the hardware does, rather than a separate
+# byte per bit.
+@define BIT_OPS "SHIFTS"
+#@define BIT_OPS "BIT_ADDRS"
 
 # It's sometimes clearer for decompilation to omit the pushing and
 # restoring of the return value for function calls.
@@ -201,6 +204,13 @@
 define register offset=0x40  size=$(SP_SIZE) [ SP ];
 define register offset=0x44  size=$(PTRSIZE) [ PC ];
 define register offset=0x48  size=1 [ PSW ];
+@if defined(MCS51)
+# SmallWorld: the address of the SFR that supplies the high byte of MOVX @Ri's
+# address.  Not a register of the hardware but a property of the device: P2
+# (0xA0) on Intel's 8051, an EMI0CN on Silicon Labs' CIP-51 devices.  The host
+# sets it before emulation starts.
+define register offset=0x4C  size=1 [ XPAGE_SFR ];
+@endif
 @if defined(DUAL_DPTR)
 # Dual DPTR
 # Rather than model it as context, we're just going
@@ -380,23 +390,42 @@
 # PSW = PSW | ((op1 < op2) << 7);
 #}
 
-macro addflags(op1, op2) {   # Flags set by add instructions
-$(CY) = (carry(op1,op2));        # Check for carry
- #OV = (scarry(op1,op2));      # Check for signed carry
-}
-
-macro subflags(op1, op2) {   # Flags set by sub instructions
-$(CY) = (op1 < op2);        # Check for carry
- #OV = sborrow(op1,op2);      # Check for signed carry
+# SmallWorld: CY, AC and OV for op1 + op2 + cin and op1 - op2 - cin.  The
+# carry-in is a separate operand: folding it into op2 first, in one byte,
+# wraps 0xFF + 1 to 0 and loses the carry or borrow out.
+macro addflags(op1, op2, cin) {   # Flags set by add instructions
+ local a:2 = zext(op1);
+ local b:2 = zext(op2);
+ local c:2 = zext(cin);
+ local wide:2 = a + b + c;
+ $(CY) = wide > 0xff;
+ $(AC) = ((a & 0xf) + (b & 0xf) + c) > 0xf;
+ local sa:2 = sext(op1);
+ local sb:2 = sext(op2);
+ local swide:2 = sa + sb + c;
+ $(OV) = (swide s> 0x7f) || (swide s< 0xff80);
+}
+
+macro subflags(op1, op2, cin) {   # Flags set by sub instructions
+ local a:2 = zext(op1);
+ local b:2 = zext(op2);
+ local c:2 = zext(cin);
+ $(CY) = a < (b + c);
+ $(AC) = (a & 0xf) < ((b & 0xf) + c);
+ local sa:2 = sext(op1);
+ local sb:2 = sext(op2);
+ local swide:2 = sa - sb - c;
+ $(OV) = (swide s> 0x7f) || (swide s< 0xff80);
 }
 
 macro compflags(op1, op2) {  # Flags set by the compare instructions
 $(CY) = (op1 < op2);        # Check for carry
 }
 
-macro resultflags(op1) { # Set N,Z flag for results
- $(N) = op1 s< 0;
- $(Z) = op1 == 0;
+# SmallWorld: the 8051 has no N or Z flag.  PSW bits 5 and 1, which $(N) and
+# $(Z) name, are the user flags F0 and F1, so writing them corrupts program
+# state.
+macro resultflags(op1) {
 }
 
 macro push8(val) {
@@ -602,6 +631,16 @@
 RiX:     @ri       is ri      { ptr:3 = zext(ri); export *[RAM]:1 ptr; }
 @endif
 
+# SmallWorld: on the 8051, MOVX @Ri takes the high byte of its address from
+# an SFR, as the hardware does - P2 on Intel's 8051; XPAGE_SFR names it.  SDCC
+# pages external RAM through it to initialize data, and to reach pdata and an
+# external stack.  Other variants keep RiX.
+@if defined(MCS51)
+RiXP:    @ri       is ri      { local page:1 = *[SFR]:1 XPAGE_SFR; ptr:2 = (zext(page) << 8) | zext(ri); export *[EXTMEM]:1 ptr; }
+@else
+RiXP:    RiX       is RiX     { export RiX; }
+@endif
+
 Data:    "#"data   is data	  { export *[const]:1 data; }
 Data16:  "#"data16 is data16  { export *[const]:2 data16; }
 @if defined(MCS80390)
@@ -620,6 +659,11 @@
 Direct:  "A"       is bank=1 & direct=0xE0 	{ export ACC; }
 Direct:  B         is bank=1 & direct=0xF0 & B  { export B;  }
 Direct:  DPL       is bank=1 & direct=0x82 & DPL 	{ export DPL; }
+# SmallWorld: SP is a register too; without this, `mov sp,#n` writes SFR 0x81.
+# Only where SP is one byte wide, as a direct operand is.
+@if defined(MCS51) || defined(MCS80390) || defined(CIP51)
+Direct:  SP        is bank=1 & direct=0x81 & SP  { export SP; }
+@endif
 Direct:  DPH       is bank=1 & direct=0x83 & DPH  { export DPH;  }
 @if defined(MCS80390)
 Direct:  DPX       is bank=1 & direct=0x93 & DPX  { export DPX;  }
@@ -640,6 +684,9 @@
 Direct2: "A"       is bank2=1 & direct2=0xE0	{ export ACC; }
 Direct2:  B        is bank2=1 & direct2=0xF0 & B  { export B;  }
 Direct2:  DPL      is bank2=1 & direct2=0x82 & DPL 	{ export DPL; }
+@if defined(MCS51) || defined(MCS80390) || defined(CIP51)
+Direct2:  SP       is bank2=1 & direct2=0x81 & SP  { export SP; }
+@endif
 Direct2:  DPH      is bank2=1 & direct2=0x83 & DPH  { export DPH;  }
 @if defined(MCS80390)
 Direct2:  DPX      is bank2=1 & direct2=0x93 & DPX  { export DPX;  }
@@ -704,15 +751,15 @@
