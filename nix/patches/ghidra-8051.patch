+@if defined(MCS51)
+# SmallWorld: the address of an SFR, on its page if it is paged; see SFR_PAGE.
+macro sfr_address(address, paged, offset) {
+	local bit:8 = (paged >> (offset & 0x3F)) & 1;
+	local page:1 = SFR_PAGE * bit:1;
+	address = (zext(page) << 8) | offset;
+}
+Direct:  direct    is bank=1 & sfr6=0 & direct 	{ local a:2 = 0; sfr_address(a, SFR_PAGED_LO, direct); export *[PSFR]:1 a; }
+Direct:  direct    is bank=1 & sfr6=1 & direct 	{ local a:2 = 0; sfr_address(a, SFR_PAGED_HI, direct); export *[PSFR]:1 a; }
+@else
 Direct:  direct    is bank=1 & direct 	{ export *[SFR]:1 direct; }
+@endif
 Direct:  PSW       is bank=1 & direct=0xD0 & PSW  { export PSW;  }
 Direct:  "A"       is bank=1 & direct=0xE0 	{ export ACC; }
 Direct:  B         is bank=1 & direct=0xF0 & B  { export B;  }
