diff --git a/target/sh4/helper.h b/target/sh4/helper.h
--- a/target/sh4/helper.h
+++ b/target/sh4/helper.h
@@ -11,6 +11,14 @@ DEF_HELPER_3(movcal, void, env, i32, i32)
 DEF_HELPER_1(discard_movcal_backup, void, env)
 DEF_HELPER_2(ocbi, void, env, i32)
 
+/*
+ * SH-2A DIVS/DIVU.  Done in helpers rather than tcg_gen_div{,u}_i32 because the
+ * architecture leaves a zero divisor (and INT_MIN / -1) undefined, whereas the
+ * host would trap.
+ */
+DEF_HELPER_FLAGS_2(divs, TCG_CALL_NO_RWG_SE, s32, s32, s32)
+DEF_HELPER_FLAGS_2(divu, TCG_CALL_NO_RWG_SE, i32, i32, i32)
+
 DEF_HELPER_3(macl, void, env, s32, s32)
