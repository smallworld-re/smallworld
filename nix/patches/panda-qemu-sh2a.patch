+/*
+ * SH7264 / SH7269: SH2A-FPU MCUs.  No MMU, no user mode, single FPU register
+ * bank.  PVR/PRR/CVR are SH-4 cache/version registers that do not exist on
+ * SH-2A; they are left at zero rather than invented.
+ */
+static void sh7264_cpu_initfn(Object *obj)
+{
+    CPUSH4State *env = cpu_env(CPU(obj));
+
+    env->id = SH_CPU_SH7264;
+    env->features = SH_FEATURE_SH2A;
+}
+
+static void sh7264_class_init(ObjectClass *oc, const void *data)
+{
+}
+
+static void sh7269_cpu_initfn(Object *obj)
+{
+    CPUSH4State *env = cpu_env(CPU(obj));
+
+    env->id = SH_CPU_SH7269;
+    env->features = SH_FEATURE_SH2A;
+}
+
+static void sh7269_class_init(ObjectClass *oc, const void *data)
+{
+}
+
 static void superh_cpu_realizefn(DeviceState *dev, Error **errp)
 {
     CPUState *cs = CPU(dev);
@@ -374,6 +428,10 @@ static const TypeInfo superh_cpu_type_infos[] = {
                            sh7751r_cpu_initfn),
     DEFINE_SUPERH_CPU_TYPE(TYPE_SH7785_CPU, sh7785_class_init,
                            sh7785_cpu_initfn),
+    DEFINE_SUPERH_CPU_TYPE(TYPE_SH7264_CPU, sh7264_class_init,
+                           sh7264_cpu_initfn),
+    DEFINE_SUPERH_CPU_TYPE(TYPE_SH7269_CPU, sh7269_class_init,
+                           sh7269_cpu_initfn),
 
