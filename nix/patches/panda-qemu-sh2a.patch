+#define CHECK_SH2A \
+    if (!(ctx->features & SH_FEATURE_SH2A)) { \
+        goto do_illegal;                      \
+    }
+
+/* SH-4-only instructions that SH-2A does not implement (no MMU, no cache
+   control, no vector FPU, single FP register bank).  */
+#define CHECK_NOT_SH2A \
+    if (ctx->features & SH_FEATURE_SH2A) { \
+        goto do_illegal;                   \
+    }
+
+/*
+ * SH-2A 32-bit instruction first words:
+ *
+ *   0011nnnnmmmm0001   mov.{b,w,l} / movu.{b,w} / fmov.{s,d} @(disp12,Rn)
+ *   0011nnnn0iii1001   b{clr,set,st,ld,ldnot,and,andnot,or,ornot,xor}.b
+ *   0000nnnniiii0000   movi20  #imm20,Rn
+ *   0000nnnniiii0001   movi20s #imm20,Rn
+ *
+ * None of these patterns is used by SH-1..SH-4, so this never changes how an
+ * SH-4 instruction stream is decoded; the caller gates on SH_FEATURE_SH2A
+ * anyway so that a non-SH-2A CPU keeps consuming two bytes per instruction.
+ */
+static bool sh2a_insn_is_op32(uint16_t opcode)
+{
+    switch (opcode & 0xf00f) {
+    case 0x3001:
+    case 0x0000:
+    case 0x0001:
+        return true;
+    }
+    return (opcode & 0xf08f) == 0x3009;
+}
+
+/*
+ * SH-2A RTS/N, RTV/N and JSR/N transfer control with *no* delay slot, so they
+ * must not set TB_FLAG_DELAY_SLOT or stage ctx->delayed_pc the way the
+ * SH-1..SH-4 branches do; the jump happens as part of this instruction.
+ */
+static void gen_sh2a_jump_now(DisasContext *ctx, TCGv target)
+{
+    gen_save_cpu_state(ctx, false);
+    tcg_gen_mov_i32(cpu_pc, target);
+    if (use_exit_tb(ctx)) {
+        tcg_gen_exit_tb(NULL, 0);
+    } else {
+        tcg_gen_lookup_and_goto_ptr();
+    }
+    ctx->base.is_jmp = DISAS_NORETURN;
+}
+
+/*
+ * SH-2A CLIPS/CLIPU record saturation in SR.CS (bit 13), which the manual
+ * describes as "1 -> CS" on clipping.  It is not cleared when no clipping
+ * occurs, i.e. it is sticky until software clears it.
+ */
+static void gen_sh2a_clip(TCGv reg, int bits, bool signed_clip)
+{
+    TCGv clipped = tcg_temp_new();
+    TCGv cs = tcg_temp_new();
+
+    if (signed_clip) {
+        tcg_gen_smin_i32(clipped, reg, tcg_constant_i32((1 << (bits - 1)) - 1));
+        tcg_gen_smax_i32(clipped, clipped, tcg_constant_i32(-(1 << (bits - 1))));
+    } else {
+        tcg_gen_umin_i32(clipped, reg, tcg_constant_i32((1u << bits) - 1));
+    }
+    tcg_gen_setcond_i32(TCG_COND_NE, cs, reg, clipped);
+    tcg_gen_shli_i32(cs, cs, SR_CS);
+    tcg_gen_or_i32(cpu_sr, cpu_sr, cs);
+    tcg_gen_mov_i32(reg, clipped);
+}
+
+/*
+ * SH-2A MOVML.L / MOVMU.L -- multi-register push/pop through R15.
+ *
+ *   MOVML.L Rm,@-R15   transfers R0..Rm      (R0 at the lowest address)
+ *   MOVML.L @R15+,Rm   the mirror image
+ *   MOVMU.L Rm,@-R15   transfers Rm..R14,PR  (Rm at the lowest address)
+ *   MOVMU.L @R15+,Rm   the mirror image
+ *
+ * In *both* instructions and *both* directions, transfer slot 15 is PR rather
+ * than R15 -- so MOVMU.L R15,@-R15 transfers PR alone, and MOVML.L R15,@-R15
+ * transfers R0..R14 and PR.  R15 is therefore never itself a transfer operand.
+ * (Checked against Ghidra's SH-2A sleigh, whose MovML/MovMU slot-15 rules all
+ * read `storeRegister(pr, r15)` / `loadRegister(pr, r15)`.)
+ *
+ * R15 is adjusted once, after every access, so that a fault part-way through
+ * leaves it untouched and the instruction restarts cleanly.
+ */
+static void gen_sh2a_movml(DisasContext *ctx, int m, bool upper, bool load)
+{
+    int count = upper ? 16 - m : m + 1;
+    TCGv addr = tcg_temp_new();
+    int i;
+
+    for (i = 0; i < count; i++) {
+        int r = upper ? m + i : i;
+        TCGv reg = (r == 15) ? cpu_pr : REG(r);
+
+        if (load) {
+            tcg_gen_addi_i32(addr, REG(15), i * 4);
+            tcg_gen_qemu_ld_i32(reg, addr, ctx->memidx, MO_TESL | MO_ALIGN);
+        } else {
+            tcg_gen_subi_i32(addr, REG(15), (count - i) * 4);
+            tcg_gen_qemu_st_i32(reg, addr, ctx->memidx, MO_TEUL | MO_ALIGN);
+        }
+    }
+
+    if (load) {
+        tcg_gen_addi_i32(REG(15), REG(15), count * 4);
+    } else {
+        tcg_gen_subi_i32(REG(15), REG(15), count * 4);
+    }
+}
