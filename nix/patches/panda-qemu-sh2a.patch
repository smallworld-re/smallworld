diff --git a/target/sh4/op_helper.c b/target/sh4/op_helper.c
--- a/target/sh4/op_helper.c
+++ b/target/sh4/op_helper.c
@@ -157,6 +157,32 @@ void helper_ocbi(CPUSH4State *env, uint32_t address)
     }
 }
 
+/*
+ * SH-2A DIVS.L / DIVU.L (32-bit / 32-bit -> 32-bit).
+ *
+ * The SH-2A manual leaves the result undefined when the divisor is zero, and
+ * signed INT_MIN / -1 is likewise not representable; both would raise SIGFPE on
+ * common hosts, so pin down a defined, non-trapping answer here.
+ */
+int32_t helper_divs(int32_t num, int32_t den)
+{
+    if (den == 0) {
+        return 0;
+    }
+    if (num == INT32_MIN && den == -1) {
+        return INT32_MIN;
+    }
+    return num / den;
+}
+
+uint32_t helper_divu(uint32_t num, uint32_t den)
+{
+    if (den == 0) {
+        return 0;
+    }
+    return num / den;
+}
