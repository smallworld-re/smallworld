+/* SH2A-FPU parts.  SH7264 and SH7269 share the same SH-2A core. */
+#define TYPE_SH7264_CPU  SUPERH_CPU_TYPE_NAME("sh7264")
+#define TYPE_SH7269_CPU  SUPERH_CPU_TYPE_NAME("sh7269")
 
