# Local PANDA/QEMU patch adding the Renesas SH-2A / SH2A-FPU instruction set to
# the sh4 target, for SmallWorld's `superh-sh2a-fpu` platform.
#
# Applies on top of panda-qemu-superh.patch, which adds the SH-4 PANDA glue and
# owns the exported sh_sr_read()/sh_sr_write() accessors this target relies on.
#
# QEMU's sh4 target only ever modelled SH-4 (sh7750r/sh7751r/sh7785). SH-2A is a
# different branch of the SuperH family: it shares the SH-2 base ISA with SH-4
# but adds ~40 instructions of its own -- including SuperH's only 32-bit
# encodings -- and drops SH-4's MMU, cache-control and vector-FPU instructions.
# Running SH-2A code on an SH-4 core therefore mis-executes exactly the
# instructions a real SH-2A compiler emits most (GCC -m2a uses MOVML/MOVMU in
# every prologue, and MOVI20 for large constants).
#
# The encodings implemented here are taken from the binutils opcode table this
# same tree already vendors at disas/sh4.c: every row tagged arch_sh2a_up or
# arch_sh2a_nofpu_up and not shared with SH-3/SH-4, with `arch_op32` marking the
# 32-bit forms. All 56 such rows are covered.
#
# What is implemented:
#   - SH_FEATURE_SH2A, TBR, SR.CS, and sh7264/sh7269 CPU models (SH2A-FPU parts)
#   - a second-word fetch for the three 32-bit first-word families
#   - all 32 SH-2A-only 16-bit encodings and all 24 32-bit rows
#   - RTS/N, RTV/N and JSR/N as genuinely delay-slot-free control transfers
#   - SH-4-only instructions (ldtlb, movca.l, ocb*, frchg, fsrra, fipr, ftrv)
#     now fault on an SH-2A CPU
#
# What is NOT implemented, deliberately:
#   - the SH-2A register bank (LDBANK/STBANK/RESBANK). These are driven by the
#     automatic bank save/restore the SH-2A interrupt controller performs on
#     exception entry, which QEMU's SH-4 model does not have at all, so there is
#     never anything meaningful in the bank. They are decoded and then raise an
#     illegal-instruction exception rather than silently returning zeroes.
#     This only affects interrupt-handler firmware.
#   - SR.CS is set on CLIPS/CLIPU saturation and never auto-cleared (sticky),
#     which is my reading of the Renesas "1 -> CS" pseudocode; unverified.
#
# See nix/patches/README.panda-qemu-sh2a.md. This is a new QEMU feature rather
# than PANDA glue and should be offered upstream; drop it once QEMU carries
# SH-2A support natively.
diff --git a/target/sh4/cpu.h b/target/sh4/cpu.h
--- a/target/sh4/cpu.h
+++ b/target/sh4/cpu.h
@@ -33,6 +33,8 @@
 #define SH_CPU_SH7751  (1 << 3)
 #define SH_CPU_SH7751R (1 << 4)
 #define SH_CPU_SH7785  (1 << 5)
+#define SH_CPU_SH7264  (1 << 6)
+#define SH_CPU_SH7269  (1 << 7)
 #define SH_CPU_SH7750_ALL (SH_CPU_SH7750 | SH_CPU_SH7750S | SH_CPU_SH7750R)
 #define SH_CPU_SH7751_ALL (SH_CPU_SH7751 | SH_CPU_SH7751R)
 
@@ -40,6 +42,7 @@
 #define SR_RB 29
 #define SR_BL 28
 #define SR_FD 15
+#define SR_CS 13                /* SH-2A only: CLIPS/CLIPU saturation status */
 #define SR_M  9
 #define SR_Q  8
 #define SR_I3 7
@@ -130,6 +133,13 @@ typedef struct tlb_t {
 enum sh_features {
     SH_FEATURE_SH4A = 1,
     SH_FEATURE_BCR3_AND_BCR4 = 2,
+    /*
+     * SH-2A / SH2A-FPU instruction set.  Selects the SH-2A-only opcodes
+     * (MOVI20, MOVU, MOVML/MOVMU, the bit-manipulation group, the 32-bit
+     * @(disp12,Rn) forms, RTS/N & friends) and disables the SH-4-only
+     * cache/MMU/vector instructions.  Mutually exclusive with SH_FEATURE_SH4A.
+     */
+    SH_FEATURE_SH2A = 4,
 };
 
