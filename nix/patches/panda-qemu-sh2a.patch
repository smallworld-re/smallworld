--- a/target/sh4/cpu.c
+++ b/target/sh4/cpu.c
@@ -159,8 +159,25 @@ static void superh_cpu_reset_hold(Object *obj, ResetType type)
     env->fpscr = FPSCR_PR; /* value for userspace according to the kernel */
     set_float_rounding_mode(float_round_nearest_even, &env->fp_status); /* ?! */
 #else
-    env->sr = (1u << SR_MD) | (1u << SR_RB) | (1u << SR_BL) |
-              (1u << SR_I3) | (1u << SR_I2) | (1u << SR_I1) | (1u << SR_I0);
+    if (env->features & SH_FEATURE_SH2A) {
+        /*
+         * SH-2A has neither an MMU nor a user mode, and no banked R0-R7.
+         * Keep SR.MD set so that QEMU's SH-4 plumbing (IS_USER(), memidx,
+         * privileged-instruction checks) treats us as privileged, but leave
+         * SR.RB clear so ctx->gbank stays 0 and R0-R7 map to gregs[0..7].
+         * SR.BL likewise does not exist on SH-2A.
+         *
+         * The architectural reset sequence loads PC and R15 from the vector
+         * table at address 0; there is no P2 mirror, so the SH-4 reset vector
+         * would be meaningless here.  Boards/harnesses set PC explicitly.
+         */
+        env->pc = 0x00000000;
+        env->sr = (1u << SR_MD) |
+                  (1u << SR_I3) | (1u << SR_I2) | (1u << SR_I1) | (1u << SR_I0);
+    } else {
+        env->sr = (1u << SR_MD) | (1u << SR_RB) | (1u << SR_BL) |
+                  (1u << SR_I3) | (1u << SR_I2) | (1u << SR_I1) | (1u << SR_I0);
+    }
     env->fpscr = FPSCR_DN | FPSCR_RM_ZERO; /* CPU reset value according to SH4 manual */
     set_float_rounding_mode(float_round_to_zero, &env->fp_status);
     set_flush_to_zero(1, &env->fp_status);
@@ -181,9 +198,17 @@ static void superh_cpu_reset_hold(Object *obj, ResetType type)
 
 static void superh_cpu_disas_set_info(CPUState *cpu, disassemble_info *info)
 {
+    CPUSH4State *env = cpu_env(cpu);
+
     info->endian = TARGET_BIG_ENDIAN ? BFD_ENDIAN_BIG
                                      : BFD_ENDIAN_LITTLE;
-    info->mach = bfd_mach_sh4;
+    /*
+     * print_insn_sh() maps the bfd machine onto a binutils architecture set,
+     * which is what gates the SH-2A-only rows (and the 32-bit @(disp12,Rn)
+     * forms) of the opcode table.  Ask for SH-2A when that is what we are.
+     */
+    info->mach = (env->features & SH_FEATURE_SH2A) ? bfd_mach_sh2a
